# The settings, as key/value pairs for the AWS Secrets Manager secret "prod/aslwizard" (deploy/README.md,
# step 5). fetch-secrets.sh writes them to ~/asl/.env on the server before each start. Never commit real values.

# Your domain (DNS A record pointing at the server's static IP). Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=aslwizard.com
PUBLIC_URL=https://aslwizard.com

# The database password: make one with `openssl rand -hex 24`. Used when the database is first created; changing
# it later also needs ALTER USER (README, step 5).
POSTGRES_PASSWORD=

# Sign-in (redirect URLs: https://aslwizard.com/auth/google/callback and .../auth/discord/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: nightly database backups to this S3 bucket (README, step 8)
BACKUP_BUCKET=

# Optional: the image (defaults: ghcr.io/ak2691/asl-game, latest; deploys set the tag themselves)
# IMAGE=ghcr.io/ak2691/asl-game
