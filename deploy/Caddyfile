# HTTPS for the game: Caddy gets and renews a Let's Encrypt certificate for SITE_ADDRESS (your domain) by itself,
# redirects http to https, and passes everything (pages, /api, /auth, the /ws WebSocket) to the game.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Vite's built files have a hash in their names, so they never change: browsers can keep them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8787
}
